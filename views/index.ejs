<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/styles.css">
  <script src="/app.js" defer></script>
</head>

<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a class="wordmark" href="/">Flight Detective</a>
      <a class="topbar-link" href="/schemas">API schemas</a>
    </div>
  </header>

  <div class="board">
    <div class="board-inner">
      <span id="stage-counter">Mission 1 of <%= stageCount %></span>
      <div class="progress-track">
        <div id="progress-bar"></div>
      </div>
    </div>
  </div>

  <main>
    <section class="game-shell">
      <section class="stub">
        <div class="stub-rule"></div>

        <div class="stub-body">
          <h2 id="stage-title">Loading…</h2>
          <p id="stage-description"></p>
          <p class="hint" id="stage-hint"></p>
        </div>
      </section>

      <form id="request-form" class="builder">
        <div class="request-grid">
          <label>
            Method
            <select id="method">
              <option value="GET">GET</option>
              <option value="POST">POST</option>
              <option value="PUT">PUT</option>
              <option value="PATCH">PATCH</option>
              <option value="DELETE">DELETE</option>
            </select>
          </label>

          <label class="path-field">
            Request path
            <input
              id="path"
              type="text"
              placeholder="/api/flights"
              autocomplete="off"
            >
          </label>
        </div>

        <section class="builder-section">
          <div class="section-title">
            <h3>Query parameters</h3>
          </div>

          <p class="helper">
            For example <code>to=Paris</code>
          </p>

          <div id="query-list"></div>

          <button type="button" class="ghost-button" id="add-query">
            + Add parameter
          </button>
        </section>

        <section class="builder-section">
          <div class="section-title">
            <h3>Request body</h3>
            <span>JSON</span>
          </div>

          <textarea
            id="body"
            rows="7"
            placeholder='{"airline":"ITA Airways","from":"TLV","to":"Rome","price":220,"seats":10}'
          ></textarea>
        </section>

        <button class="send-button" type="submit">Send request</button>
      </form>

      <section id="response-panel" class="console hidden">
        <div class="console-heading">
          <p class="console-label">Server response</p>
          <span id="status-badge" class="status-badge"></span>
        </div>

        <h3 id="response-title"></h3>
        <p id="response-message"></p>
        <pre id="response-data"></pre>

        <div id="next-area" class="next-area hidden">
          <button id="next-button" class="next-button" type="button">
            Next mission
          </button>
        </div>
      </section>

      <section id="expected-panel" class="console console-expected hidden">
        <div class="console-heading">
          <p class="console-label">What a correct request returns</p>
          <span id="expected-status-badge" class="status-badge"></span>
        </div>

        <pre id="expected-response-data"></pre>
      </section>
    </section>
  </main>

  <footer>
    <p>Flight Detective — Node.js, Express, EJS, vanilla JavaScript.</p>
  </footer>
</body>
</html>