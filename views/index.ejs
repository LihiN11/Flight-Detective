<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title><%= title %></title>

  <link rel="stylesheet" href="/styles.css">
  <script src="/app.js" defer></script>
</head>

<body>
  <header class="hero">
    <nav class="navbar">
      <a class="logo" href="/">
        ✈️ Flight Detective
      </a>

      <a class="schemas-link" href="/schemas">
        API Schemas
      </a>
    </nav>

    <div class="hero-content">
      <p class="eyebrow">LEARN HTTP • REST • AJAX</p>

      <h1>Flight Detective</h1>

      <p>
        Build the correct HTTP request, send it to the server,
        and complete every flight mission.
      </p>
    </div>
  </header>

  <main>
    <section class="game-shell">
      <div class="top-row">
        <div>
          <p class="eyebrow">CURRENT MISSION</p>
          <h2 id="stage-title">Loading...</h2>
        </div>

        <div class="progress-wrap">
          <span id="stage-counter">
            Mission 1 of <%= stageCount %>
          </span>

          <div class="progress-track">
            <div id="progress-bar"></div>
          </div>
        </div>
      </div>

      <section class="scenario">
        <div class="scenario-icon">✈️</div>

        <div>
          <h3>Flight Mission</h3>
          <p id="stage-description"></p>
          <p class="hint" id="stage-hint"></p>
        </div>
      </section>

      <form id="request-form">
        <div class="request-grid">
          <label>
            HTTP Method

            <select id="method">
              <option value="GET">GET</option>
              <option value="POST">POST</option>
              <option value="PUT">PUT</option>
              <option value="PATCH">PATCH</option>
              <option value="DELETE">DELETE</option>
            </select>
          </label>

          <label class="path-field">
            Request Path

            <input
              id="path"
              type="text"
              placeholder="/api/flights"
              autocomplete="off"
            >
          </label>
        </div>

        <section class="builder-section">
          <div class="section-title">
            <h3>Query Parameters</h3>
            <span>Optional</span>
          </div>

          <p class="helper">
            Example: <code>to=Paris</code>
          </p>

          <div id="query-list"></div>

          <button
            type="button"
            class="small-button"
            id="add-query"
          >
            + Add Query Parameter
          </button>
        </section>

        <section class="builder-section">
          <div class="section-title">
            <h3>Request Body</h3>
            <span>JSON</span>
          </div>

          <textarea
            id="body"
            rows="8"
            placeholder='{"airline":"ITA Airways","from":"TLV","to":"Rome","price":220,"seats":10}'
          ></textarea>
        </section>

        <button class="send-button" type="submit">
          ✈️ Send HTTP Request
        </button>
      </form>

      <section
        id="response-panel"
        class="response-panel hidden"
      >
        <div class="response-heading">
          <div>
            <p class="eyebrow">ACTUAL SERVER RESPONSE</p>
            <h3 id="response-title"></h3>
          </div>

          <span id="status-badge"></span>
        </div>

        <p id="response-message"></p>
        <pre id="response-data"></pre>

        <div id="next-area" class="next-area hidden">
          <button
            id="next-button"
            class="next-button"
            type="button"
          >
            Next Mission →
          </button>
        </div>
      </section>

      <section
        id="expected-panel"
        class="response-panel hidden"
      >
        <div class="response-heading">
          <div>
            <p class="eyebrow">EXPECTED SERVER RESPONSE</p>

            <h3>
              This is what the correct request returns
            </h3>
          </div>

          <span id="expected-status-badge"></span>
        </div>

        <pre id="expected-response-data"></pre>
      </section>
    </section>
  </main>

  <footer>
    <p>
      ✈️ Flight Detective • Node.js • Express • EJS • Vanilla JavaScript
    </p>
  </footer>
</body>
</html>