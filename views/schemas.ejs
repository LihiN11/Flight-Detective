<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title><%= title %></title>

  <link
    rel="stylesheet"
    href="/styles.css"
  >

</head>


<body>


  <header class="simple-header">

    <nav class="navbar">

      <a
        class="logo"
        href="/"
      >
        ✈️ Flight Detective
      </a>

      <a
        class="schemas-link"
        href="/"
      >
        Game
      </a>

    </nav>


    <div class="hero-content">

      <p class="eyebrow">
        SERVER-SIDE RENDERED PAGE
      </p>

      <h1>
        API Schemas
      </h1>

      <p>
        The following schemas are sent
        from the server and rendered
        using EJS.
      </p>

    </div>

  </header>


  <main class="schemas-page">


    <% schemas.forEach((schema) => { %>


      <section class="schema-card">

        <div class="schema-icon">
          ✈️
        </div>

        <h2>
          <%= schema.resource %>
        </h2>


        <table>

          <thead>

            <tr>

              <th>
                Field
              </th>

              <th>
                Data Type
              </th>

            </tr>

          </thead>


          <tbody>


            <% schema.fields.forEach((field) => { %>


              <tr>

                <td>
                  <%= field[0] %>
                </td>

                <td>
                  <%= field[1] %>
                </td>

              </tr>


            <% }) %>


          </tbody>

        </table>

      </section>


    <% }) %>


  </main>


  <footer>

    <p>
      ✈️ Flight Detective
    </p>

  </footer>


</body>

</html>